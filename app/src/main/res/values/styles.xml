<?xml version="1.0" encoding="utf-8"?>
<!-- Estilización de cada tipo de botón -->


<resources>
    <!--Redondeo de las esquinas-->
    <style name="ShapeOverlay.SmartCalc.Button.Diagonal" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
    </style>
    <!--Estilo base para todos los botones -->
    <style name="Widget.SmartCalc.Button" parent = "Widget.Material3.Button">
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeOverlay.SmartCalc.Button.Diagonal</item>
        <item name="strokeWidth">4dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- botones numéricos-->
    <style name="Widget.SmartCalc.Button.Number" parent = "Widget.SmartCalc.Button">
        <item name="backgroundTint">?attr/colorSurfaceVariant</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:fontFamily">@font/sewer</item>
        <item name="android:textSize">30sp</item>
    </style>

    <!-- Botones para operadores basicos-->
    <style name="Widget.SmartCalc.Button.Operator" parent = "Widget.SmartCalc.Button">
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones para acciones especiales (C, DEL, +-) -->
    <style name="Widget.SmartCalc.Button.Special" parent="Widget.SmartCalc.Button">
        <item name="backgroundTint">?attr/colorTertiaryContainer</item>
        <item name="android:textColor">?attr/colorOnTertiaryContainer</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- botón para destacar el ifual (=) -->
    <style name="Widget.SmartCalc.Button.Equals" parent = "Widget.SmartCalc.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>



</resources>